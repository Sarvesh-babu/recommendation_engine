# Copy this file to backend/.env and fill in your own values.
# backend/.env is git-ignored, so your key never leaves your machine.

# Groq API key for the Layer 1 AI refinement step.
# Create a free key at https://console.groq.com/keys
# Everything else in the app (EDA, training, recommendations, Insights, cart) works without it.
GROQ_API_KEY=
